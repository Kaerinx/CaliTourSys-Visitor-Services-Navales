NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calitoursys_dev
CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=1mb
REQUIRE_POSTGRES_ON_START=false

JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_SECRET=change_me_to_a_long_random_visitor_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
JWT_EXPIRES_IN=8h

CMS_COOKIE_NAME=calitoursys_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=5

VISITOR_DB_HOST=localhost
VISITOR_DB_PORT=3306
VISITOR_DB_USER=root
VISITOR_DB_PASSWORD=
VISITOR_DB_NAME=calitoursys
VISITOR_DB_CONNECTION_LIMIT=10
